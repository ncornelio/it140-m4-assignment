
# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode

START hilow_game

    OUTPUT "Welcome to the Higher/Lower Game!"

    # Establish a valid guessing range.
    OUTPUT "Enter the lower bound:"
    INPUT lower_bound

    OUTPUT "Enter the upper bound:"
    INPUT upper_bound

    WHILE lower_bound >= upper_bound
        OUTPUT "Invalid range. The lower bound must be less than the upper bound."

        OUTPUT "Enter the lower bound:"
        INPUT lower_bound

        OUTPUT "Enter the upper bound:"
        INPUT upper_bound
    END WHILE

    # Establish the number the player is trying to guess.
    SET secret_number = RANDOM INTEGER BETWEEN lower_bound AND upper_bound

    # Play the game.
    SET guess = lower_bound - 1

    WHILE guess != secret_number

        OUTPUT "Enter your guess:"
        INPUT guess

        # Validate the user's guess.
        WHILE guess < lower_bound OR guess > upper_bound
            OUTPUT "Invalid guess. Enter a number within the selected bounds."
            OUTPUT "Enter your guess:"
            INPUT guess
        END WHILE

        # Compare the guess and provide feedback.
        IF guess < secret_number
            OUTPUT "Too low! Try again."

        ELSE IF guess > secret_number
            OUTPUT "Too high! Try again."

        ELSE
            OUTPUT "Congratulations! You guessed the correct number!"
        END IF

    END WHILE

    OUTPUT "Thanks for playing!"

END hilow_game

